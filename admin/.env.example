# 环境变量样例：新增 VITE_ 变量时同步本文件（对齐仓库红线"新增配置必须同步 .env.example"）
# 真实环境请复制为 .env.development / .env.production

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# dev server 端口（避开 web 端的 5173）
VITE_PORT = 5174

# 应用版本号（注入 __APP_VERSION__）
VITE_VERSION = 0.1.0

# API 请求基础路径：开发环境为 /（走代理），生产环境为 /（同源反向代理）
VITE_API_URL = /

# 代理目标地址（仅开发环境使用）：本机 FastAPI
VITE_API_PROXY_URL = http://127.0.0.1:8000

# 访问控制模式：frontend = 前端本地菜单（EverKB 菜单在 src/router/modules 定义）；backend = 后端菜单接口
VITE_ACCESS_MODE = frontend

# Delete console
VITE_DROP_CONSOLE = false
