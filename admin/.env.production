# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# vite preview 端口（生产构建不启 dev server，此值仅供本地预览产物使用）
VITE_PORT = 5174

# 应用版本号（vite.config.ts 注入 __APP_VERSION__，发版时随 package.json 同步）
VITE_VERSION = 0.1.0

# API 地址前缀
# 生产与后端同源部署（Nginx/Caddy 反向代理 /api → FastAPI，见总排期第 6 步），走相对路径
VITE_API_URL = /

# 访问控制模式：frontend = 前端本地菜单
VITE_ACCESS_MODE = frontend

# Delete console
VITE_DROP_CONSOLE = true
