# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# dev server 端口（vite.config.ts 读取；避开 web 端的 5173，两个前端可同时启动）
VITE_PORT = 5174

# 应用版本号（vite.config.ts 注入 __APP_VERSION__）
VITE_VERSION = 0.1.0

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
# EverKB FastAPI 后端（docker compose 启动，见 ../docker-compose.yml）
VITE_API_PROXY_URL = http://192.168.1.249:8000

# 访问控制模式：frontend = 前端本地菜单（EverKB 菜单在 src/router/modules 定义，不走后端菜单接口）
VITE_ACCESS_MODE = frontend

# Delete console
VITE_DROP_CONSOLE = false
