# EverKB 环境变量模板 —— 与 backend/app/core/config.py 的 Settings 字段一一对应
# 复制本文件为 .env 后填写真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，绝不提交真实密钥

# ── 数据库 / 中间件 ─────────────────────────────────────────────
# 以下两个密码由 docker-compose.yml 直接读取（用于初始化容器），务必与 URL 内嵌密码一致
MYSQL_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
MYSQL_URL=mysql+pymysql://root:change-me@127.0.0.1:3307/everkb?charset=utf8mb4
MILVUS_URI=http://127.0.0.1:19530
COLLECTION_NAME=rag_chunk
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# ── 存储（local | oss；文档原文存储，Milvus 向量存储已内置本地化）──
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# ── Embedding（OpenAI 兼容协议；可替换任意厂商）────────────────────
# 关键：EMBEDDING_DIM 必须与所选模型的真实输出维度一致（Milvus 建集合用）。
# 完整替换指引见 docs/模型接入指南.md，常见厂商示例：
#
#   DashScope（通义，默认）   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  EMBEDDING_MODEL=text-embedding-v4  EMBEDDING_DIM=1024
#   OpenAI 官方              EMBEDDING_BASE_URL=https://api.openai.com/v1                       EMBEDDING_MODEL=text-embedding-3-small  EMBEDDING_DIM=1536
#   硅基流动（BGE）           EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1                  EMBEDDING_MODEL=BAAI/bge-m3  EMBEDDING_DIM=1024
#   Ollama（本地）           EMBEDDING_BASE_URL=http://localhost:11434/v1                       EMBEDDING_MODEL=nomic-embed-text  EMBEDDING_DIM=768
#
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ── 鉴权（管理端 JWT；账号存 admin_user 表，首账号用 python3 scripts/seed_admin.py 创建）──
# JWT_SECRET 建议 ≥32 字节随机串：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24

# ── 切块 / 上传限制 ────────────────────────────────────────────
CHUNK_TARGET_CHARS=600
CHUNK_OVERLAP_CHARS=60
UPLOAD_MAX_BYTES=209715200
WEB_DOC_MAX_URLS=50

# ── Worker ────────────────────────────────────────────────────
WORKER_ENABLED=true
WORKER_INTERVAL_SEC=5

# ── LLM（问答链路的答案生成；OpenAI 兼容协议，可替换任意厂商）──────────
# 关键：只需改 ARK_BASE_URL / ARK_API_KEY / ARK_MODEL 三个值即可换成自己的模型。
# 完整替换指引见 docs/模型接入指南.md，下面列出常见厂商示例（去掉注释即可用）：
#
#   火山方舟（豆包，默认）    ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  ARK_MODEL=doubao-seed-2-0-lite-260428
#   DeepSeek 官方            ARK_BASE_URL=https://api.deepseek.com                 ARK_MODEL=deepseek-chat
#   通义千问（DashScope）     ARK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  ARK_MODEL=qwen-plus
#   Moonshot（Kimi）         ARK_BASE_URL=https://api.moonshot.cn/v1               ARK_MODEL=moonshot-v1-8k
#   Ollama（本地）           ARK_BASE_URL=http://localhost:11434/v1                 ARK_MODEL=qwen2.5:7b
#   智谱（GLM）              ARK_BASE_URL=https://open.bigmodel.cn/api/paas/v4      ARK_MODEL=glm-4
#
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428
