# EverKB 环境变量模板 —— 与 backend/app/core/config.py 的 Settings 字段一一对应
# 复制本文件为 .env 后填写真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，绝不提交真实密钥

# ── 数据库 / 中间件 ─────────────────────────────────────────────
MYSQL_URL=mysql+pymysql://root:change-me@127.0.0.1:3307/everkb?charset=utf8mb4
MILVUS_URI=http://127.0.0.1:19530
COLLECTION_NAME=rag_chunk
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# ── 存储（local | oss；文档原文存储，Milvus 向量存储已内置本地化）──
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# ── Embedding（OpenAI 兼容协议；预置 DashScope 兼容模式）──────────
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ── 鉴权（管理端 JWT；账号存 admin_user 表，首账号用 python3 scripts/seed_admin.py 创建）──
# JWT_SECRET 建议 ≥32 字节随机串：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24

# ── 切块 / 上传限制 ────────────────────────────────────────────
CHUNK_TARGET_CHARS=600
CHUNK_OVERLAP_CHARS=60
UPLOAD_MAX_BYTES=209715200
WEB_DOC_MAX_URLS=50

# ── Worker ────────────────────────────────────────────────────
WORKER_ENABLED=true
WORKER_INTERVAL_SEC=5

# ── LLM（Plan 2 问答链路用；config 经 alias 读 ARK_ 字段）───────
# 火山方舟 OpenAI 兼容端点（豆包/DeepSeek/Qwen 等按开通情况选），答案生成
# 模型 ID 需在方舟控制台已开通（本机已开通 doubao-seed-2-0-lite-260428 / doubao-seed-2-1-turbo-260628）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428
